{

  "name": "vtm-character-sheet",
  "version": "1.0.0",
  "description": "Character sheet for Vampire the Masquerade 5th Edition.",

  "typings": "./public/dist/main.d.ts",
  "main": "./public/dist/main.js",

  "exports": {
    ".": {
      "require": {
        "types": "./public/dist/main.d.ts",
        "default": "./public/dist/main.js"
      }
    }
  },

  "scripts": {

    "prepare": "npx husky || true",

    "lint-front": "npx eslint --config .eslintrc-front.js --ext .ts,.tsx,.cts,.mts ./public/src/**/*",
    "lint": "npm run lint-front",

    "clean-front": "npx rimraf ./public/dist",
    "clean": "npm run clean-front",

    "build-front": "npm run clean-front && npx webpack --config \"./webpack.config-front.js\" && npx tsc --project ./tsconfig.json --emitDeclarationOnly",
    "build-tests": "npx webpack --config \"./webpack.config-test.js\"",
    "build": "npm run build-front && npm run build-tests",

    "check-requires": "npx used-deps-analyzer ./package.json ./public/src --no-dev",
    "check-updates": "npx check-version-modules --no-fail-at-major --fail-at-minor --fail-at-patch",
    "unit-tests": "echo 'not unit tests here'",
    "unit-tests-local": "echo 'not unit tests here'",

    "tests": "npm run lint && npm run check-requires && npm run check-updates && npm run build && npm run unit-tests-local"

  },

  "files": [
    "/public/dist",
    "/public/languages"
  ],
  "engines": {
    "node": ">=22.22.0"
  },

  "dependencies": {},
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "check-version-modules": "2.2.2",
    "colors": "1.4.0",
    "css-loader": "7.1.4",
    "sass": "1.93.3",
    "sass-loader": "16.0.6",
    "eslint-plugin-personnallinter": "git+ssh://git@github.com/Psychopoulet/eslint-plugin-personnallinter",
    "husky": "9.1.7",
    "i18next": "26.0.3",
    "i18next-browser-languagedetector": "8.2.1",
    "react-i18next": "17.0.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "style-loader": "4.0.0",
    "ts-loader": "9.5.4",
    "used-deps-analyzer": "0.2.0",
    "webpack": "5.105.4",
    "webpack-cli": "7.0.2"
  },

  "keywords": [
    "typescript",
    "react",
    "masquerade",
    "vampire"
  ],

  "husky": {
    "hooks": {
      "pre-commit": "npm run lint",
      "pre-push": "npm run build && npm run unit-tests-local"
    }
  },

  "author": "Sébastien VIDAL",
  "license": "ISC",

  "homepage": "https://github.com/Psychopoulet/vtm-character-sheet#readme",
  "repository": {
    "type": "git",
    "url": "git://github.com/Psychopoulet/vtm-character-sheet.git"
  },
  "bugs": {
    "url": "https://github.com/Psychopoulet/vtm-character-sheet/issues"
  }

}
